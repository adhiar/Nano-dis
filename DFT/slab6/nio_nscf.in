&CONTROL
    calculation  = 'nscf'
    prefix       = 'NiO100_6L_PBEU5_relax'
    outdir       = './tmp'
    pseudo_dir   = './pseudopot'
    restart_mode = 'from_scratch'
    verbosity    = 'high'
/
&SYSTEM
    ibrav     = 0
    nat       = 24
    ntyp      = 3
    ecutwfc   = 50
    ecutrho   = 400
    nspin     = 2
    input_dft = 'PBE'
    occupations = 'smearing'
    smearing = 'mv'
    degauss = 0.01
nbnd=220
    starting_magnetization(1) =  0.60
    starting_magnetization(2) = -0.60
    starting_magnetization(3) =  0.00
/
&ELECTRONS
    conv_thr         = 1.0d-8
    electron_maxstep = 200
    mixing_mode      = 'plain'
    mixing_beta      = 0.10
    mixing_ndim      = 8
    diagonalization  = 'david'
    diago_david_ndim = 2
    startingpot      = 'file'
    startingwfc      = 'file'
/

