&CONTROL
    calculation  = "scf"
    max_seconds  =  8.64000e+04
    outdir       = "./outdir"
    prefix       = "NiO"
    pseudo_dir   = "./pseudopot/"
    restart_mode = "from_scratch"
    tprnfor      = .TRUE.
/

&SYSTEM
    a                         =  4.18000e+00
    degauss                   =  1.00000e-02
    ecutrho                   =  5.00000e+02
    ecutwfc                   =  5.00000e+01
    ibrav                     = 1
    nat                       = 4
    nbnd                      = 36
    nspin                     = 2
    ntyp                      = 3
    occupations               = "smearing"
    smearing                  = "gaussian"
    starting_magnetization(1) =  2.00000e-01
    starting_magnetization(2) = -2.00000e-01
/

&ELECTRONS
    conv_thr         =  1.00000e-08
    electron_maxstep = 200
    mixing_beta      =  3.00000e-01
    startingpot      = "atomic"
    startingwfc      = "atomic+random"
/

K_POINTS {automatic}
 4  4  4  0 0 0

ATOMIC_SPECIES
Ni1    58.69340  ni_pbe_v1.4.uspp.F.UPF
Ni2    58.69340  ni_pbe_v1.4.uspp.F.UPF
O      15.99900  O.pbe-n-kjpaw_psl.1.0.0.UPF

ATOMIC_POSITIONS {crystal}
Ni1     0.000000   0.000000   0.000000
Ni2    -0.500000   1.500000  -0.500000
O       0.750000  -0.250000  -0.250000
O      -0.750000   0.250000   0.250000

HUBBARD ortho-atomic
U Ni1-3d 5.0
U Ni2-3d 5.0
